  "codeRules": [
    {
      "match": "ENG",
      "typeId": "engine",
      "note": "Locomotive"
    },
    {
      "match": "LOCO",
      "typeId": "engine"
    },
    {
      "match": "EOG",
      "typeId": "eog"
    },
    {
      "match": "HOG",
      "typeId": "eog"
    },
    {
      "match": "PC",
      "typeId": "pantry"
    },
    {
      "match": "SLR",
      "typeId": "slr"
    },
    {
      "match": "SLRD",
      "typeId": "slr"
    },
    {
      "match": "HCPV",
      "typeId": "parcel"
    },
    {
      "match": "VP",
      "typeId": "parcel"
    },
    {
      "match": "re:^(HA?|H)\\d+$",
      "typeId": "ac1",
      "note": "1A / HA"
    },
    {
      "match": "1A",
      "typeId": "ac1"
    },
    {
      "match": "re:^A\\d+$",
      "typeId": "ac2",
      "note": "2A"
    },
    {
      "match": "2A",
      "typeId": "ac2"
    },
    {
      "match": "re:^B\\d+$",
      "typeId": "ac3",
      "note": "3A"
    },
    {
      "match": "3A",
      "typeId": "ac3"
    },
    {
      "match": "LPR",
      "typeId": "parcel",
      "note": "Luggage / parcel"
    },
    {
      "match": "re:^BE\\d*$",
      "typeId": "ac3",
      "note": "3A economy / BE"
    },
    {
      "match": "re:^M\\d+$",
      "typeId": "ac3",
      "note": "3E"
    },
    {
      "match": "3E",
      "typeId": "ac3"
    },
    {
      "match": "re:^C\\d+$",
      "typeId": "chair"
    },
    {
      "match": "CC",
      "typeId": "chair"
    },
    {
      "match": "EC",
      "typeId": "chair"
    },
    {
      "match": "2S",
      "typeId": "chair"
    },
    {
      "match": "re:^D\\d+$",
      "typeId": "chair",
      "note": "2S day coaches"
    },
    {
      "match": "re:^S\\d+$",
      "typeId": "sleeper"
    },
    {
      "match": "SL",
      "typeId": "sleeper"
    },
    {
      "match": "GS",
      "typeId": "general"
    },
    {
      "match": "GEN",
      "typeId": "general"
    }
  ]
